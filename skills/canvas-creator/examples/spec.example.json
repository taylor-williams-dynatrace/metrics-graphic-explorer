{
  "name": "Production Host Health",
  "canvas": { "width": 1600, "height": 900, "columns": 3, "margin": 40, "gap": 24 },
  "tiles": [
    {
      "kind": "metric",
      "metricKey": "dt.host.cpu.usage",
      "aggregation": "avg",
      "lookback": "-15m",
      "label": "CPU usage",
      "unit": "%",
      "thresholds": [
        { "comparator": "gte", "value": 90, "color": "critical" },
        { "comparator": "gte", "value": 75, "color": "warning" }
      ]
    },
    {
      "kind": "metric",
      "metricKey": "dt.host.memory.usage",
      "aggregation": "avg",
      "lookback": "-15m",
      "label": "Memory usage",
      "unit": "%",
      "thresholds": [
        { "comparator": "gte", "value": 90, "color": "critical" }
      ]
    },
    {
      "kind": "dql",
      "display": "value",
      "dql": "timeseries v = avg(dt.host.disk.usedPct, scalar:true), from:-15m",
      "label": "Disk used",
      "unit": "%"
    },
    {
      "kind": "dql",
      "display": "table",
      "dql": "fetch logs | filter loglevel == \"ERROR\" | summarize errors = count(), by:{host} | sort errors desc | limit 20",
      "columns": ["host", "errors"],
      "label": "Top error hosts (15m)",
      "span": 2
    },
    {
      "kind": "metric",
      "metricKey": "dt.host.net.nic.traffic.in",
      "aggregation": "sum",
      "lookback": "-1h",
      "label": "Inbound traffic (1h)",
      "unit": "B"
    }
  ]
}
